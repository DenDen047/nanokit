{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
    "ECC_MCP_RECONNECT_ZOTERO": "bash ~/.claude/scripts/zotero-mcp-server.sh start",
    "ECC_MCP_RECONNECT_WORKSPACE_PERSONAL": "bash ~/.claude/scripts/workspace-mcp-personal-server.sh start",
    "ECC_MCP_RECONNECT_WORKSPACE_HDT": "bash ~/.claude/scripts/workspace-mcp-hdt-server.sh start",
    "ECC_MCP_RECONNECT_SCRAPLING": "bash ~/.claude/scripts/scrapling-mcp-server.sh start"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(ps:*)",
      "Bash(wc:*)",
      "Bash(mmdc:*)",
      "Bash(gh api:*)",
      "Bash(gh search:*)",
      "Bash(git add:*)",
      "Bash(git commit -m:*)",
      "Bash(grep:*)",
      "Bash(pixi info:*)",
      "Bash(pixi install:*)",
      "Bash(pixi run:*)",
      "Bash(tmux:*)",
      "Bash(claude:*)",
      "Bash(mkdir:*)",
      "Bash(TZ=Asia/Tokyo date:*)",
      "Bash(spark:*)",
      "Read(/tmp/*)",
      "Edit(/tmp/*)",
      "Bash(rm /tmp*)",
      "Read(**/.claude/settings.json)",
      "Read(**/.claude/settings.local.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "WebSearch",
      "WebFetch",
      "mcp__scrapling__make_request",
      "mcp__scrapling__open_request_session",
      "mcp__scrapling__session_make_request",
      "mcp__scrapling__browser_fetch_once",
      "mcp__scrapling__browser_open",
      "mcp__scrapling__browser_fetch",
      "mcp__scrapling__browser_extract",
      "mcp__scrapling__browser_screenshot",
      "mcp__scrapling__browser_network_requests",
      "mcp__scrapling__browser_network_request",
      "mcp__scrapling__close_session",
      "mcp__scrapling__list_sessions"
    ],
    "ask": [
      "Bash(jl destroy:*)",
      "Bash(jl filesystem remove:*)",
      "Bash(jl deploy delete:*)"
    ],
    "deny": [
      "Bash(spark draft:*)",
      "Bash(spark action:*)",
      "Bash(spark contact-action:*)",
      "Bash(spark comment:*)",
      "Bash(spark event:*)"
    ],
    "defaultMode": "auto"
  },
  "cleanupPeriodDays": 36500,
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/zotero-mcp-server.sh start",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/workspace-mcp-personal-server.sh start",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/workspace-mcp-hdt-server.sh start",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/scrapling-mcp-server.sh start",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/agent-config-sync-reconnect.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/nanokit-upgrade.sh --report",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/karpathy-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/orca-tab-worktree-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/vision-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__navigate|mcp__playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/vision-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/memory-extract.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun x -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "clangd-lsp@claude-plugins-official": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "concise-clear",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
