{
  "$schema": "https://opencode.ai/config.json",
  // 無検閲のエージェントの送り先 (frogiraffe OKF decisions/uncensored-agent-opencode-abliteration.md)。
  // OpenCode 2 は起動時の -m が無いので、ここで標準のモデルを決める。
  "model": "abliteration-ai/abliterated-model-large-v2",
  // 会話を opencode.ai の公開ページにする /share を塞ぐ。
  "share": "disabled",
  // OpenCode 自身の配信 (Zen) を外す。無料のモデルは会話を学習に使うことがあり、
  // Claude Code の指示とスキルを読ませた状態でそこへ送らないため。
  "disabled_providers": ["opencode"],
  // 自宅の GPU PC (RTX 5070 Ti 16GB) の llama-server。中継サーバーを通らない無検閲のモデル。
  // 起動は GPU PC の ~/Documents/Projects/local-llm/serve.sh、鍵は GPU PC と同じものを Mac の
  // ~/.config/local-llm/api-key に置く。IP は固定していないので mDNS 名で指す。
  "providers": {
    "local-llm": {
      "name": "Local LLM (自宅 GPU PC)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://ikuta-MS-7E26.local:8080/v1",
        "apiKey": "{file:~/.config/local-llm/api-key}"
      },
      "models": {
        "qwen3.8-27b-rvn": {
          "modelID": "qwen3.8-27b-rvn",
          "name": "Local Qwen3.8 27B RVN (Q3_K_S, 無検閲)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "compatibility": { "reasoningField": "reasoning_content" },
          // サーバーの文脈は 131,072。出力に 16K を残す。
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },
  // OpenCode 2 は CLAUDE.md を自動では読まない (AGENTS.md だけ)。Claude Code と同じ指示を読ませる。
  // スキルは ~/.claude/skills を OpenCode 2 が自分で探す。
  "instructions": ["~/.claude/CLAUDE.md"],
  // OpenCode 2 はプロジェクトの外のファイルに断りなく触れる。OpenCode 1 と同じく、触る前に聞かせる。
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  // Web を読む道具だけをつなぐ。Notion・Slack・Gmail などは、読んだ中身がモデルの送り先へ渡るのでつながない。
  "mcp": {
    "servers": {
      // Claude Code と同じ Playwright MCP。--isolated で毎回まっさらなプロファイルにし、
      // Claude Code 側の Playwright のログイン状態を無検閲のモデルに渡さない (同時に動かしてもぶつからない)。
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest", "--isolated"]
      },
      // Claude Code・Codex と共有している常駐の Scrapling (127.0.0.1 のみ、認証なし)。
      "scrapling": {
        "type": "remote",
        "url": "http://127.0.0.1:8323/mcp",
        "oauth": false
      }
    }
  }
}
