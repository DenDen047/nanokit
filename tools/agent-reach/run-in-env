#!/usr/bin/env bash
# Agent Reach env の共有ラッパ。呼ばれた名前をそのまま env 内のコマンドとして実行する。
#
# 同ディレクトリの agent-reach は、このファイルへの symlink。
# dotter がそれぞれを ~/.pixi/bin/<name> に配り (PATH 済み)、実行時の $0 の
# basename で分岐する。実装を 1 つに保ちつつ、コマンド名を ls で見えるようにする形。
# なぜ pixi global ではなくプロジェクト env なのかは ./pixi.toml を参照。
set -euo pipefail

# 呼ばれた名前 = 実行するコマンド。symlink を辿る前に確定させる。
cmd="$(basename "$0")"

# このスクリプトの実体があるディレクトリを解決する。~/.pixi/bin/<name> →
# tools/agent-reach/<name> → run-in-env と 2 段の symlink を辿るので繰り返す。
# 古い macOS の BSD readlink には -f が無いため手で辿る。
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")" && pwd)"

if [[ "$cmd" == "agent-reach" ]]; then
    # agent-reach は PATH 上の opencli の実体から npm パッケージ内の dist/src/daemon.js を辿る。
    # 版固定の npx ラッパー (./opencli) ではその形にならないので、同じ版を env の node で .opencli/ に入れて先頭に置く。
    # 版の単一ソースはラッパーの固定行で、nanokit upgrade がそこを上げると次の呼び出しで新しい版が入る。
    spec="$(grep -oE '@jackwener/opencli@[0-9][^"]*' "$here/opencli" | head -n 1)"
    ocdir="$here/.opencli/${spec##*@}"
    if [[ ! -x "$ocdir/node_modules/.bin/opencli" ]]; then
        pixi run --manifest-path "$here/pixi.toml" npm install --prefix "$ocdir" --no-package-lock \
            --no-fund --no-audit --loglevel=error "$spec" >&2
    fi
    export PATH="$ocdir/node_modules/.bin:$PATH"

    # 専用ブラウザに CloakBrowser ではなく既存の Chrome を使わせる (理由は use-system-chrome.py)。
    # 一度記録すれば Agent Reach が覚えているので、記録が無いときだけ走らせる。
    if ! grep -qs '"backend"' "$HOME/.agent-reach/browser/state.json"; then
        pixi run --manifest-path "$here/pixi.toml" python "$here/use-system-chrome.py"
    fi
fi

# `pixi run` は初回に pixi.lock から env を作るので、新しいホストでも準備は不要。
# 認証情報はこのリポジトリの外 (~/.agent-reach/ と環境変数) に置く。
exec pixi run --manifest-path "$here/pixi.toml" "$cmd" "$@"
